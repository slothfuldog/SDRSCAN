# Frontend (Nuxt) configuration. Copy to `.env` (git-ignored); Nuxt loads it automatically.
# Only used by `npm run dev` and the helper scripts. The production build is a static site served by
# sdrscan-backend on the same origin, so it needs no environment at all.

# Backend the dev server proxies /api to. The backend must list your dev host in SDRSCAN_ALLOWED_HOSTS
# (e.g. localhost:3000) and run with SDRSCAN_COOKIE_SECURE=false on plain HTTP.
SDRSCAN_API_URL=http://127.0.0.1:8080

# `npm run dev:mock` (mock API without a backend): port of the mock server.
# MOCK_PORT=8787

# scripts/csp-preview.mjs (serve the build under the backend's CSP): preview port and optional CSP override.
# PORT=4173
# CSP=
