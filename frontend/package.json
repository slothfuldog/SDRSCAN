  "description": "SDRScan (Sast Dast Rust Scan) web UI: Nuxt 3 SPA embedded into sdrscan-backend",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:mock": "node scripts/dev-mock.mjs",
