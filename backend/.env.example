# sdrscan-backend configuration. Copy to `.env` (git-ignored) and adjust.
# Go does not read .env by itself: `make run` (in backend/) loads it, or use `set -a; . ./.env; set +a`.
# Keep values on one line; quote values that contain spaces or special characters.

# --- Required -----------------------------------------------------------------
# PostgreSQL 15+ (TLS is required for non-local hosts).
DATABASE_URL=postgres://sdrscan:CHANGE_ME@127.0.0.1:5433/sdrscan_app?sslmode=disable

# --- Server -------------------------------------------------------------------
SDRSCAN_LISTEN=127.0.0.1:8080
# Accepted Host header values (default: listen address + localhost). Add the public host name behind a proxy.
# SDRSCAN_ALLOWED_HOSTS=127.0.0.1:8080,localhost:8080
# Serve the built frontend from disk (otherwise the embedded copy is used).
SDRSCAN_WEB_DIR=../frontend/.output/public
# Session cookie "Secure" flag. Set to false ONLY for plain HTTP on localhost.
SDRSCAN_COOKIE_SECURE=false
# Trust X-Forwarded-For for the client IP (only behind your own reverse proxy).
SDRSCAN_TRUST_PROXY=false
SDRSCAN_LOG_LEVEL=info
SDRSCAN_LOG_FORMAT=text
SDRSCAN_AUTO_MIGRATE=true

# --- Secrets ------------------------------------------------------------------
# AES-256 key (32 random bytes, base64) that encrypts stored git credentials.
# Generate one with: openssl rand -base64 32   (keep it stable, or stored credentials become unreadable)
SDRSCAN_SECRET_KEY=
# First Admin, created only while the users table is empty; the password must be changed at first login.
# SDRSCAN_BOOTSTRAP_ADMIN_USER=admin
# SDRSCAN_BOOTSTRAP_ADMIN_PASSWORD=
# SDRSCAN_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# --- Scan engines -------------------------------------------------------------
SDRSCAN_SAST_BIN=../dist/sdrscan-sast
SDRSCAN_DAST_BIN=../dist/sdrscan-dast
SDRSCAN_TEMPLATES=../dist/templates/php
SDRSCAN_WORKDIR=/tmp/sdrscan
SDRSCAN_WORKERS=2
# Total job timeout (one value sets both; default 30m SAST / 60m DAST).
# SDRSCAN_SCAN_TIMEOUT=30m
SDRSCAN_SCHEDULER_ENABLED=true
SDRSCAN_SCHEDULE_MIN_INTERVAL_SAST=15m
SDRSCAN_SCHEDULE_MIN_INTERVAL_DAST=60m

# --- Vulnerability (CVE) checks -----------------------------------------------
# Directory of the local vulnerability database (OSV/NVD data written by `sdrscan-vuln update`).
# Empty (default) = CVE / dependency checks are OFF. Passed as --vuln-db to sdrscan-sast and sdrscan-dast
# when the directory exists and the engine supports the flag. Install/refresh it as Admin in
# "Vulnerability database" (or run `sdrscan-vuln update --db <dir>` yourself).
# SDRSCAN_VULN_DB=/var/lib/sdrscan/vulndb
# The sdrscan-vuln executable used by the Admin update job.
# SDRSCAN_VULN_BIN=../dist/sdrscan-vuln
# Time limit of one database update (default 60m).
# SDRSCAN_VULN_UPDATE_TIMEOUT=60m
# Master switch: false stops passing the database to the engines (default true).
# SDRSCAN_SCA_ENABLED=true
# Optional scheduled update (5-field cron, UTC, at least 1 hour apart; needs the scheduler). Default: none.
# SDRSCAN_VULN_UPDATE_CRON=30 3 * * *
# PEM file with the CA(s) the updater trusts (internal proxy / CA); passed as --ca-cert. Empty = system trust store.
# SDRSCAN_VULN_CA_CERT=/path/to/internal-ca.pem
# The update runs with a clean environment; only HTTP(S)_PROXY, NO_PROXY, SSL_CERT_FILE/DIR and NVD_API_KEY
# (optional, higher NVD rate limit) are passed on.

# --- Git clone ----------------------------------------------------------------
# known_hosts file for SSH clones (no trust on first use).
# SDRSCAN_GIT_KNOWN_HOSTS=/path/to/known_hosts
# Comma-separated allow list of git hosts (default: any public host).
# SDRSCAN_GIT_ALLOWED_HOSTS=github.com,gitlab.com

# --- DAST TLS -----------------------------------------------------------------
# PEM file with the CA(s) trusted for HTTPS targets (internal CAs). Empty = system trust store.
# SDRSCAN_DAST_CA_CERT=/path/to/internal-ca.pem
# UNSAFE: do not verify target certificates. Only for targets you trust (e.g. a dev environment).
SDRSCAN_DAST_INSECURE_TLS=false

# --- Ingest limits ------------------------------------------------------------
SDRSCAN_MAX_BODY_MB=50
SDRSCAN_MAX_RESULTS=100000
# Extra rule ids whose findings are treated as secrets (snippets redacted).
# SDRSCAN_SECRET_RULES=php-hardcoded-secret

# --- Private networks --------------------------------------------------------
# Git clones and DAST scans may reach private networks by default (loopback, 10.x, 172.16-31.x,
# 192.168.x, 100.64/10, IPv6 ULA, link-local). Cloud metadata endpoints (169.254.169.0/24,
# 169.254.170.0/24, 100.100.100.200, fd00:ec2::/32, metadata.google.internal) are always refused.
# Set to false on a shared or cloud host to refuse private networks: anyone allowed to register a
# target can otherwise probe the internal network from this server.
# SDRSCAN_ALLOW_PRIVATE_NETWORKS=false

# --- Test / demo only (keep false in real use) --------------------------------
# Accept local paths and file:// as repo_url.
SDRSCAN_TEST_ALLOW_LOCAL_REPOS=false
# Lift the private-network policy for clone and DAST.
SDRSCAN_TEST_ALLOW_PRIVATE_NETWORKS=false
